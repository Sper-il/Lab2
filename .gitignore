# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
.cursor/

# Data
data/raw/
data/processed/*
!data/processed/demo/
!data/processed/demo/*
data/splits/
# (giữ lại data/README.md — tài liệu, không phải dataset)
!data/README.md

# Models (weight nang: khong push; chi giu README/configs/JSON nhe + .gitkeep giu folder)
models/checkpoints/*
!models/checkpoints/.gitkeep
models/trained/*
!models/trained/.gitkeep
!models/trained/*.json
*.pt
*.pth
*.onnx
*.h5

# TensorBoard / results
# CHỈ ignore thư mục `runs/` ở gốc project (TensorBoard logdir).
# Dùng dấu / đầu + / cuối để KHÔNG khớp `results/runs/`.
/runs/

# Checkpoint nặng trong results (bỏ qua) — nhưng giữ lại metrics/config/plots/report.html
results/runs/**/checkpoints/
results/runs/*/*.pt
results/runs/*/*.pth
results/runs/**/*.pt
results/runs/**/*.pth
# TensorBoard event local-only (mỗi run ~1 MB, tái tạo bằng train lại) — giữ metrics.json/PNG/config/report.html
results/runs/**/tb/

# Logs
*.log
logs/
.pytest_cache/

# Secrets
.env
*.key
secrets.yaml
